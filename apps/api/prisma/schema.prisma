generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyRole {
  OWNER
  ADMIN
  MEMBER
}

enum ScopedRole {
  MANAGER
  MEMBER
  VIEWER
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AccessRequestScope {
  DEPARTMENT
  BOARD
  EPIC
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskActivityType {
  CREATED
  COMMENTED
  MOVED
  TITLE_CHANGED
  DESCRIPTION_CHANGED
  PRIORITY_CHANGED
  ASSIGNEE_CHANGED
  WATCHER_ADDED
  WATCHER_REMOVED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
}

model User {
  id                     String             @id @default(cuid())
  name                   String
  email                  String             @unique
  passwordHash           String
  memberships            CompanyMember[]
  boardMembers           BoardMember[]
  departmentMembers      DepartmentMember[]
  accessRequests         AccessRequest[]    @relation("AccessRequestRequester")
  reviewedAccessRequests AccessRequest[]    @relation("AccessRequestReviewer")
  assignedTasks          Task[]             @relation("TaskAssignee")
  taskComments           TaskComment[]
  taskWatchers           TaskWatcher[]
  taskActivities         TaskActivity[]
  taskAttachments        TaskAttachment[]
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
}

model Company {
  id                        String          @id @default(cuid())
  name                      String
  slug                      String          @unique
  themePrimaryColor         String          @default("#07182f")
  themeSecondaryColor       String          @default("#12335f")
  themeAccentColor          String          @default("#1d4ed8")
  themeBoardBackgroundColor String          @default("#d9e6f2")
  members                   CompanyMember[]
  departments               Department[]
  accessRequests            AccessRequest[]
  epics                     Epic[]
  createdAt                 DateTime        @default(now())
  updatedAt                 DateTime        @updatedAt
}

model CompanyMember {
  id        String      @id @default(cuid())
  role      CompanyRole @default(MEMBER)
  isActive  Boolean     @default(true)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([userId, companyId])
}

model Department {
  id             String             @id @default(cuid())
  name           String
  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId      String
  boards         Board[]
  members        DepartmentMember[]
  accessRequests AccessRequest[]
  epics          Epic[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model DepartmentMember {
  id           String     @id @default(cuid())
  role         ScopedRole @default(MEMBER)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([departmentId, userId])
  @@index([userId])
}

model Board {
  id             String          @id @default(cuid())
  key            String
  name           String
  description    String?
  department     Department      @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId   String
  columns        BoardColumn[]
  members        BoardMember[]
  tasks          Task[]
  accessRequests AccessRequest[]
  epicTaskLinks  EpicTaskLink[]
  nextTaskNumber Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([departmentId, key])
}

model BoardColumn {
  id        String   @id @default(cuid())
  name      String
  position  Int
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   String
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([boardId, position])
}

model BoardMember {
  id        String     @id @default(cuid())
  board     Board      @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      ScopedRole @default(MEMBER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([boardId, userId])
  @@index([userId])
}

model Task {
  id             String           @id @default(cuid())
  friendlyId     String
  sequenceNumber Int
  title          String
  description    String?
  priority       TaskPriority     @default(MEDIUM)
  position       Int
  board          Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId        String
  column         BoardColumn      @relation(fields: [columnId], references: [id], onDelete: Cascade)
  columnId       String
  assignee       User?            @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assigneeId     String?
  comments       TaskComment[]
  watchers       TaskWatcher[]
  activities     TaskActivity[]
  attachments    TaskAttachment[]
  epicTaskLinks  EpicTaskLink[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([boardId, friendlyId])
  @@unique([boardId, sequenceNumber])
  @@index([boardId, columnId, position])
}

model AccessRequest {
  id              String              @id @default(cuid())
  scope           AccessRequestScope
  status          AccessRequestStatus @default(PENDING)
  message         String?
  company         Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String
  requester       User                @relation("AccessRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId     String
  reviewer        User?               @relation("AccessRequestReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewerId      String?
  department      Department?         @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  departmentId    String?
  board           Board?              @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId         String?
  epic            Epic?               @relation(fields: [epicId], references: [id], onDelete: Cascade)
  epicId          String?
  requestedRole   ScopedRole          @default(VIEWER)
  decisionMessage String?
  decidedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([companyId, status, createdAt])
  @@index([requesterId, status])
  @@index([departmentId, status])
  @@index([boardId, status])
  @@index([epicId, status])
}

model Epic {
  id                String          @id @default(cuid())
  title             String
  description       String?
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId         String
  ownerDepartment   Department      @relation(fields: [ownerDepartmentId], references: [id], onDelete: Cascade)
  ownerDepartmentId String
  taskLinks         EpicTaskLink[]
  accessRequests    AccessRequest[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([companyId, createdAt])
  @@index([ownerDepartmentId, createdAt])
}

model EpicTaskLink {
  id        String   @id @default(cuid())
  epic      Epic     @relation(fields: [epicId], references: [id], onDelete: Cascade)
  epicId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  board     Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  boardId   String
  createdAt DateTime @default(now())

  @@unique([epicId, taskId])
  @@index([taskId])
  @@index([boardId])
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId, createdAt])
}

model TaskWatcher {
  id        String   @id @default(cuid())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskActivity {
  id        String           @id @default(cuid())
  type      TaskActivityType
  metadata  Json?
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId    String
  actor     User             @relation(fields: [actorId], references: [id], onDelete: Cascade)
  actorId   String
  createdAt DateTime         @default(now())

  @@index([taskId, createdAt])
}

model TaskAttachment {
  id          String   @id @default(cuid())
  fileName    String
  contentType String
  sizeBytes   Int
  storageKey  String
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId      String
  uploader    User     @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  uploaderId  String
  createdAt   DateTime @default(now())

  @@index([taskId, createdAt])
}
