{
  "name": "taskboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "dev": "node scripts/dev-apps.mjs",
    "dev:api": "npm run dev --workspace @taskboard/api",
    "dev:stop": "node scripts/stop-dev-apps.mjs",
    "dev:web": "npm run dev --workspace @taskboard/web",
    "dev:demo": "npm run dev:demo --workspace @taskboard/web",
    "build": "npm run build --workspaces --if-present",
    "build:demo": "npm run build:demo --workspace @taskboard/web",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "npm run test --workspaces --if-present",
    "prisma:generate": "npm run prisma:generate --workspace @taskboard/api"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  }
}
